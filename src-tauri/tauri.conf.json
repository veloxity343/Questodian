{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Questodian",
  "version": "0.1.1",
  "identifier": "app.questodian.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
